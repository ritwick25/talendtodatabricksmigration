      },
      "expected_output": {
        "valid": true,
        "local_date": "2024-03-31",
        "is_leap_year": true,
        "utc_date": "2024-03-31",
        "next_billing_date": "2024-04-30",
        "is_leap_anniversary": false
      }
    }
