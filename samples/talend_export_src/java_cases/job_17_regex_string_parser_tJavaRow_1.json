      "expected_output": {
        "priority": "NORMAL",
        "order_id": 99887,
        "subject_clean": "Re: Order#99887 shipment delay",
        "ticket_code": "RE:",
        "tags_trimmed_split_len": 3,
        "tags_preserved_split_len": 3,
        "tags_normalized": "shipping; delay"
      }
