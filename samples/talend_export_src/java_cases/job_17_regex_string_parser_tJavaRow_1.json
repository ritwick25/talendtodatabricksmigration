        "tag_string": "billing,refund,,urgent,"
      },
      "expected_output": {
        "priority": "URGENT",
        "order_id": 12345,
        "subject_clean": "Re: Order#12345 - refund request",
        "ticket_code": "RE:",
        "tags_trimmed_split_len": 4,
        "tags_preserved_split_len": 5,
        "tags_normalized": "billing; refund; urgent"
      }
    },
    {
      "case_id": 2,
      "description": "no priority tag -> defaults to NORMAL",
      "input": {
        "raw_subject": "Re: Order#99887 shipment delay",
