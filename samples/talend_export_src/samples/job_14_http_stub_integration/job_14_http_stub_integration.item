    <node componentName="tJavaRow" componentVersion="0.102" posX="320" posY="80" uniqueName="tJavaRow_1">
      <elementParameter name="CODE" field="CODE"><![CDATA[
// tJavaRow_1 -- Pattern: SIDE EFFECTS (a stubbed HTTP call behind a small interface -- no real
// network -- and a JDBC-style helper that "queries" a local fixture file the way a real
// FixtureJdbcHelper would query a staging table). DERIVED: depends on input_row + local files.

HttpClientStub http = new HttpClientStub();
FixtureJdbcHelper jdbc = new FixtureJdbcHelper((String)context.source_dir + "/vendor_directory.csv");

boolean vendorActive = jdbc.isVendorActive(input_row.vendor_id);
HttpResponseStub resp = http.postJson(input_row.endpoint_path, input_row.payload_json);

output_row.webhook_id = input_row.webhook_id;
output_row.vendor_id = input_row.vendor_id;
output_row.vendor_active = vendorActive;
output_row.http_status = resp.statusCode;
output_row.http_ok = resp.statusCode >= 200 && resp.statusCode < 300;

/** Minimal canned HTTP response -- no real network I/O. */
static class HttpResponseStub {
    int statusCode;
    String body;
    HttpResponseStub(int c, String b) { statusCode = c; body = b; }
}

/** Stand-in for a real HTTP client; deterministically derives a status from the payload shape. */
static class HttpClientStub {
    HttpResponseStub postJson(String path, String jsonBody) {
        if (path == null || path.startsWith("/events/unknown")) {
            return new HttpResponseStub(404, "{\"error\":\"unknown endpoint\"}");
        }
        if (jsonBody == null || jsonBody.trim().equals("{}")) {
            return new HttpResponseStub(422, "{\"error\":\"empty payload\"}");
        }
        return new HttpResponseStub(200, "{\"status\":\"accepted\"}");
    }
}

/** JDBC-style helper: opens/reads/closes a local CSV fixture the way a real DB lookup would. */
static class FixtureJdbcHelper {
    private final String path;
    FixtureJdbcHelper(String path) { this.path = path; }

    boolean isVendorActive(String vendorId) {
        java.io.BufferedReader reader = null;
        try {
            reader = new java.io.BufferedReader(new java.io.FileReader(path));
            String header = reader.readLine();
            String line;
            while ((line = reader.readLine()) != null) {
                String[] parts = line.split(",", -1);
                if (parts.length >= 3 && parts[0].equals(vendorId)) {
                    return "true".equalsIgnoreCase(parts[2].trim());
                }
            }
            return false;
        } catch (java.io.IOException e) {
            return false;
        } finally {
            if (reader != null) {
                try { reader.close(); } catch (java.io.IOException ignored) { }
            }
        }
    }
}
]]></elementParameter>
