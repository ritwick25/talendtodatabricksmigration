<?xml version="1.0" encoding="UTF-8"?>
<talendJob name="Org Hierarchy Depth &amp; Cycle Detection" jobId="job_19_control_flow_recursive" synthetic="true" neverOpenedInRealTalendStudio="true">
  <description>Computes each employee&#x27;s depth in the org hierarchy via a recursive CONTROL FLOW Java block with cycle detection (custom checked exception routed to reject), a string switch on level_hint, and a labeled-break conflict scan, before inserting valid rows into org_hierarchy_flat.</description>
  <contextRef group="Migration_Context"/>
  <nodes>
    <node componentName="tFileInputDelimited" componentVersion="0.102" posX="80" posY="80" uniqueName="tFileInputDelimited_1">
      <elementParameter name="FILENAME" field="TEXT" value="(String)context.source_dir + &quot;/org_hierarchy.csv&quot;"/>
      <elementParameter name="HEADER" field="TEXT" value="1"/>
      <metadata connector="FLOW">
        <column name="employee_id" type="id_String" length="" precision="" nullable="true" key="true"/>
        <column name="manager_id" type="id_String" length="" precision="" nullable="true" key="false"/>
        <column name="name" type="id_String" length="" precision="" nullable="true" key="false"/>
        <column name="level_hint" type="id_String" length="" precision="" nullable="true" key="false"/>
      </metadata>
    </node>
    <node componentName="tJavaRow" componentVersion="0.102" posX="320" posY="80" uniqueName="tJavaRow_1">
      <elementParameter name="CODE" field="CODE"><![CDATA[
// tJavaRow_1 -- Pattern: CONTROL FLOW (recursion with cycle detection, string switch, labeled
// break, try/catch/finally with a custom exception routed to reject). The recursion/switch/
// conflict-scan logic is pure given (employeeId, managerOf map, levelHint); only the lazy
// one-time load of managerOf below touches context.source_dir (plumbing) -- the core algorithm
// is executed standalone in java_cases/job_19_control_flow_recursive_tJavaRow_1.json (JAVA_EXECUTED).

if (managerOf == null) {
    managerOf = loadManagerMap((String)context.source_dir + "/org_hierarchy.csv");
}

int level;
switch (input_row.level_hint == null ? "" : input_row.level_hint) {
    case "EXEC": level = 1; break;
    case "DIR":  level = 2; break;
    case "MGR":  level = 3; break;
    case "IC":   level = 4; break;
    default:     level = 5; break;
}

boolean[][] conflictMatrix = {{false, false}, {false, false}};
boolean anomaly = false;
scan:
for (int i = 0; i < conflictMatrix.length; i++) {
    for (int j = 0; j < conflictMatrix[i].length; j++) {
        if (conflictMatrix[i][j]) { anomaly = true; break scan; }
    }
}

try {
    int depth = computeDepth(input_row.employee_id, managerOf, new java.util.HashSet<String>());
    output_row.employee_id = input_row.employee_id;
    output_row.level_from_hint = level;
    output_row.depth = depth;
    output_row.error_message = "";
} catch (CyclicHierarchyException e) {
    output_row.employee_id = input_row.employee_id;
    output_row.level_from_hint = level;
    output_row.depth = -1;
    output_row.error_message = e.getMessage();
} finally {
    globalMap.put("job19_lastEmployeeId", input_row.employee_id);
}

static class CyclicHierarchyException extends Exception {
    CyclicHierarchyException(String msg) { super(msg); }
}

private int computeDepth(String employeeId, java.util.Map<String, String> managerOf, java.util.Set<String> visiting)
        throws CyclicHierarchyException {
    if (visiting.contains(employeeId)) {
        throw new CyclicHierarchyException("cycle detected at " + employeeId);
    }
    String manager = managerOf.get(employeeId);
    if (manager == null || manager.isEmpty() || manager.equals(employeeId)) {
        return 0;
    }
    visiting.add(employeeId);
    try {
        return 1 + computeDepth(manager, managerOf, visiting);
    } finally {
        visiting.remove(employeeId);
    }
}

private java.util.Map<String, String> loadManagerMap(String csvPath) {
    java.util.Map<String, String> map = new java.util.HashMap<String, String>();
    try (java.io.BufferedReader r = new java.io.BufferedReader(new java.io.FileReader(csvPath))) {
        String header = r.readLine();
        String line;
        while ((line = r.readLine()) != null) {
            String[] parts = line.split(",", -1);
            if (parts.length >= 2) { map.put(parts[0], parts[1]); }
        }
    } catch (java.io.IOException e) {
        System.err.println("loadManagerMap: failed reading " + csvPath + ": " + e.getMessage());
    }
    return map;
}
]]></elementParameter>
      <metadata connector="FLOW">
        <column name="employee_id" type="id_String" length="" precision="" nullable="true" key="true"/>
        <column name="level_from_hint" type="id_Integer" length="" precision="" nullable="true" key="false"/>
        <column name="depth" type="id_Integer" length="" precision="" nullable="true" key="false"/>
        <column name="error_message" type="id_String" length="" precision="" nullable="true" key="false"/>
      </metadata>
    </node>
    <node componentName="tFilterRow" componentVersion="0.102" posX="560" posY="80" uniqueName="tFilterRow_1">
      <elementParameter name="FILTER_EXPRESSION" field="TEXT" value="error_message.isEmpty()"/>
    </node>
    <node componentName="tDBOutput" componentVersion="0.102" posX="800" posY="40" uniqueName="tDBOutput_1">
      <elementParameter name="TABLE" field="TEXT" value="org_hierarchy_flat"/>
      <elementParameter name="ACTION" field="TEXT" value="INSERT"/>
      <elementParameter name="JDBC_URL" field="TEXT" value="(String)context.db_url"/>
      <elementParameter name="SCHEMA" field="TEXT" value="(String)context.target_schema"/>
    </node>
    <node componentName="tFileOutputDelimited" componentVersion="0.102" posX="800" posY="180" uniqueName="tFileOutputDelimited_1">
      <elementParameter name="FILENAME" field="TEXT" value="(String)context.source_dir + &quot;/../fixtures_output/org_hierarchy_errors.csv&quot;"/>
    </node>
  </nodes>
  <connections>
    <connection source="tFileInputDelimited_1" target="tJavaRow_1" connectorName="FLOW"/>
    <connection source="tJavaRow_1" target="tFilterRow_1" connectorName="FLOW"/>
    <connection source="tFilterRow_1" target="tDBOutput_1" connectorName="FLOW" label="valid"/>
    <connection source="tFilterRow_1" target="tFileOutputDelimited_1" connectorName="REJECT" label="cyclic_or_invalid"/>
  </connections>
</talendJob>